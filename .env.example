# CareerAI Environment Configuration Example

# Project Info
PROJECT_NAME="CareerAI — AI Career Intelligence & Job Recommendation Platform"
VERSION="1.0.0"

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default local SQLite:
DATABASE_URL="sqlite:///career_ai.db"
# Or PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/career_ai_db"

# Frontend API URL
VITE_API_URL="http://localhost:8000/api/v1"
